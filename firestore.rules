rules_version = '2';

// El rol NO se deduce del correo. Es admin quien tenga un documento en
// `admins/{uid}`, y esa colección solo se escribe desde la consola de Firebase
// (o con el Admin SDK), nunca desde la app. Así nadie puede ascenderse a sí
// mismo registrando una cuenta con un dominio elegido a dedo.
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function miCorreo() {
      return request.auth.token.email;
    }

    // Cada usuario lee únicamente su propio documento, que es lo que la app
    // necesita para saber si mostrar el panel o el portal del socio.
    // Nadie escribe acá desde el cliente: los admins se dan de alta a mano.
    match /admins/{uid} {
      allow read: if estaAutenticado() && request.auth.uid == uid;
      allow write: if false;
    }

    match /members/{memberId} {
      // El admin ve a todos. El socio, solo su propia ficha.
      allow read: if esAdmin()
        || (estaAutenticado() && resource.data.email == miCorreo());

      // OJO: en Firestore `update` NO incluye `create`. Si el admin no figura
      // acá, no puede dar de alta a nadie.
      //
      // El admin crea la ficha de cualquiera. Quien se registra puede crearse
      // la suya, pero solo con su propio correo, sin regalarse el estado de
      // pago ni una rutina, y sin meter campos que no existen en el modelo.
      allow create: if esAdmin() || (
        estaAutenticado()
        && request.resource.data.email == miCorreo()
        && request.resource.data.status == 'No pago'
        && request.resource.data.routine == 'Sin asignar'
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'plan', 'expires', 'status', 'routine', 'initials', 'color'])
      );

      // Modificar planes, estados de pago y rutinas es cosa del admin.
      allow update, delete: if esAdmin();
    }

    // Las rutinas las lee cualquier usuario con sesión; solo el admin las edita.
    match /routines/{routineId} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }

    // Los planes son públicos para quien tenga sesión; los edita el admin.
    match /memberships/{membershipId} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }

    // Firestore ya deniega por defecto todo lo que no tenga una regla que lo
    // permita, así que este bloque no cambia el comportamiento: está para dejar
    // la intención escrita. Un `if false` nunca anula un `allow` de arriba.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
